{
  "name": "pi-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Source-only Pi extensions: worktree panel and thin Pueue adapter",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Unverricht",
  "keywords": ["pi-package"],
  "engines": { "node": ">=24.0.0" },
  "files": ["extensions/worktree-panel/src", "extensions/worktree-panel/README.md", "extensions/worktree-panel/LICENSE", "extensions/worktree-panel/CHANGELOG.md", "extensions/worktree-panel/index.ts", "extensions/pueue/*.ts", "extensions/pueue/callback.mjs", "extensions/pueue/README.md", "README.md", "LICENSE", "docs", "nix"],
  "pi": { "extensions": ["./extensions/worktree-panel/index.ts", "./extensions/pueue/index.ts"] },
  "scripts": {
    "test": "node --test extensions/worktree-panel/test/*.test.mjs extensions/pueue/test/*.test.mjs test/*.test.mjs",
    "check": "tsc --noEmit && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
