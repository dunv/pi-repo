{
  "name": "pi-worktree-panel",
  "version": "0.3.1",
  "description": "A lightweight, worktree-only right-side Git changed-files overlay for Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Unverricht",
  "keywords": [
    "pi-package",
    "pi-extension",
    "git",
    "worktree",
    "sidebar"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
